# ==========================================================
# ตั้งค่าการเชื่อมต่อ Google Sheets API (ตัวเลือกเสริม)
# หากยังไม่ใส่ค่าเหล่านี้ ระบบจะทำงานในโหมด Demo/Local อัตโนมัติทันที!
# เมื่อใส่ครบทั้ง 3 ค่า ระบบจะสลับไปอ่าน/เขียนข้อมูลลง Google Sheets ทันที
# ==========================================================

# 1. Spreadsheet ID จาก URL ของ Google Sheet
# ตัวอย่าง URL: https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOpQrStUvWxYz/edit
# ค่าคือ: 1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_SHEET_ID=

# 2. อีเมลของ Service Account ที่สร้างจาก Google Cloud Console
# (อย่าลืมกด Share ไฟล์ Google Sheet ให้กับอีเมลนี้แบบ Editor ด้วย)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 3. Private Key จากไฟล์ JSON ของ Service Account
# ให้คัดลอกข้อความตั้งแต่ "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" มาวาง
GOOGLE_PRIVATE_KEY=

# 4. Google OAuth 2.0 Client ID สำหรับปุ่ม Sign in with Google บนหน้าเว็บ
# สร้างได้ที่ https://console.cloud.google.com/apis/credentials (Authorized JavaScript origins: http://localhost:3000)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 5. AppSheet REST API v2 (ตัวเลือกเสริมสำหรับยิง Automation Bot บน AppSheet แบบ Parallel)
APPSHEET_APP_ID=
APPSHEET_ACCESS_KEY=

